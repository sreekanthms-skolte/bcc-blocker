<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">

  <Id>7b8db4c7-9f1b-4d8e-9e1a-7d7db8bf6f21</Id>

  <Version>1.0.0.4</Version>

  <ProviderName>Skolte Solutions</ProviderName>

  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="BCC Blocker"/>

  <Description DefaultValue="Blocks manual Bcc recipients before an email is sent."/>

  <IconUrl
    DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/assets/icon-32.png"/>

  <HighResolutionIconUrl
    DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/assets/icon-80.png"/>

  <SupportUrl
    DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/taskpane.html"/>

  <AppDomains>
    <AppDomain>https://sreekanthms-skolte.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation
          DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule
      xsi:type="ItemIs"
      ItemType="Message"
      FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>


  <!-- ========================================================= -->
  <!-- VersionOverrides 1.0                                     -->
  <!-- ========================================================= -->

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <!-- ======================================================= -->
    <!-- VersionOverrides 1.1                                   -->
    <!-- ======================================================= -->

    <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets DefaultMinVersion="1.15">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>


      <Hosts>

        <Host xsi:type="MailHost">

          <!-- Event-based activation runtime -->

          <Runtimes>

            <!-- Browser runtime:
                 Outlook Web / New Outlook -->
            <Runtime resid="WebViewRuntime.Url">

              <!-- JavaScript runtime:
                   Classic Outlook -->
              <Override
                type="javascript"
                resid="JSRuntime.Url"/>

            </Runtime>

          </Runtimes>


          <DesktopFormFactor>

            <FunctionFile resid="Commands.Url"/>


            <!-- ================================================= -->
            <!-- Compose button                                   -->
            <!-- ================================================= -->

            <ExtensionPoint
              xsi:type="MessageComposeCommandSurface">

              <OfficeTab id="TabDefault">

                <Group id="bccBlockerGroup">

                  <Label resid="GroupLabel"/>


                  <Control
                    xsi:type="Button"
                    id="bccBlockerInfoButton">

                    <Label resid="InfoButton.Label"/>

                    <Supertip>

                      <Title resid="InfoButton.Label"/>

                      <Description resid="InfoButton.Tooltip"/>

                    </Supertip>


                    <Icon>

                      <bt:Image
                        size="16"
                        resid="Icon.16x16"/>

                      <bt:Image
                        size="32"
                        resid="Icon.32x32"/>

                      <bt:Image
                        size="80"
                        resid="Icon.80x80"/>

                    </Icon>


                    <Action xsi:type="ShowTaskpane">

                      <SourceLocation
                        resid="Taskpane.Url"/>

                    </Action>

                  </Control>

                </Group>

              </OfficeTab>

            </ExtensionPoint>


            <!-- ================================================= -->
            <!-- OnMessageSend                                    -->
            <!-- ================================================= -->

            <ExtensionPoint xsi:type="LaunchEvent">

              <LaunchEvents>

                <LaunchEvent
                  Type="OnMessageSend"
                  FunctionName="onMessageSendHandler"
                  SendMode="Block"/>

              </LaunchEvents>

              <!-- IMPORTANT:
                   Must match the browser runtime above -->
              <SourceLocation
                resid="WebViewRuntime.Url"/>

            </ExtensionPoint>

          </DesktopFormFactor>

        </Host>

      </Hosts>


      <!-- ===================================================== -->
      <!-- Resources                                            -->
      <!-- ===================================================== -->

      <Resources>

        <bt:Images>

          <bt:Image
            id="Icon.16x16"
            DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/assets/icon-16.png"/>

          <bt:Image
            id="Icon.32x32"
            DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/assets/icon-32.png"/>

          <bt:Image
            id="Icon.80x80"
            DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/assets/icon-80.png"/>

        </bt:Images>


        <bt:Urls>

          <bt:Url
            id="Commands.Url"
            DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/commands.html"/>

          <bt:Url
            id="Taskpane.Url"
            DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/taskpane.html"/>

          <!-- Browser runtime for Outlook Web -->
          <bt:Url
            id="WebViewRuntime.Url"
            DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/commands.html"/>

          <!-- JavaScript runtime for Classic Outlook -->
          <bt:Url
            id="JSRuntime.Url"
            DefaultValue="https://sreekanthms-skolte.github.io/bcc-blocker/launchevent.js"/>

        </bt:Urls>


        <bt:ShortStrings>

          <bt:String
            id="GroupLabel"
            DefaultValue="Compliance"/>

          <bt:String
            id="InfoButton.Label"
            DefaultValue="BCC Policy"/>

        </bt:ShortStrings>


        <bt:LongStrings>

          <bt:String
            id="InfoButton.Tooltip"
            DefaultValue="Shows the organization's Bcc policy."/>

        </bt:LongStrings>

      </Resources>

    </VersionOverrides>

  </VersionOverrides>

</OfficeApp>
